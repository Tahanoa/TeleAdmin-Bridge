<?xml version="1.0"?>
<ruleset name="TeleAdmin Bridge">
	<description>WordPress coding standards for TeleAdmin Bridge.</description>
	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<config name="text_domain" value="teleadmin-bridge"/>
	<config name="minimum_supported_wp_version" value="6.4"/>
</ruleset>
